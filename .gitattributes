# Auto detect text files and normalize line endings
* text=auto

# GitHub Linguist language hints
*.py linguist-language=Python
*.sql linguist-language=SQL
src/sql/** linguist-language=SQL linguist-detectable=true
*.bat linguist-language=Batchfile

# SQL files
*.sql text eol=lf

# Python files
*.py text eol=lf

# Batch files should keep Windows line endings
*.bat text eol=crlf

# Markdown and documentation
*.md text eol=lf
*.txt text eol=lf

# Environment examples
.env.example text eol=lf

# Excel and document files are binary
*.xlsx binary
*.xls binary
*.docx binary
*.pbix binary

# SQLite databases are binary
*.db binary
*.sqlite binary
*.sqlite3 binary
